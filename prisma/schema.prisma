generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum GuestStatus {
  AGUARDANDO
  CONFIRMADO
  NAO_CONFIRMADO
}

enum InviteStatus {
  NAO_ENVIADO
  ENVIADO
}

enum GuestType {
  ADULTO
  IDOSO
  CRIANCA
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  login     String   @unique
  senha     String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Guest {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  nome            String
  celular         String
  tipo            GuestType    @default(ADULTO)
  status          GuestStatus  @default(AGUARDANDO)
  conviteStatus   InviteStatus @default(NAO_ENVIADO)
  isRepresentante Boolean      @default(false)
  createdAt       DateTime     @default(now())
  confirmacao     DateTime?
  link            GuestLink?
  familyId        String?      @db.ObjectId
  family          Family?      @relation(fields: [familyId], references: [id])
}

model GuestLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  guestId   String   @unique @db.ObjectId
  token     String   @unique
  createdAt DateTime @default(now())
  guest     Guest    @relation(fields: [guestId], references: [id])
}

model Family {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  celular       String
  conviteStatus InviteStatus @default(NAO_ENVIADO)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  members       Guest[]
  link          FamilyLink?
}

model FamilyLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  familyId  String   @unique @db.ObjectId
  token     String   @unique
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id])
}

model Event {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  dataEvento DateTime
  mensagem   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
